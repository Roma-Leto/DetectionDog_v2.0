# ============================================================
# DetectionDog Translator Service — переменные окружения
# ============================================================

# --- Сервер ---
HOST=0.0.0.0
PORT=5002
LOG_LEVEL=info

# --- Модель ---
# NLLB-200-distilled-600M — компактная, качественная, многоязычная.
# Альтернатива для меньшего размера: Helsinki-NLP/opus-mt-en-ru (300 МБ).
MODEL_ID=facebook/nllb-200-distilled-600M

# Языки (ISO-639-3 коды для NLLB)
SOURCE_LANG=eng_Latn
TARGET_LANG=rus_Cyrl

# --- Устройство ---
DEVICE=auto
DTYPE=float16

# --- Лимиты ---
MAX_TEXT_LENGTH=2000
INFERENCE_TIMEOUT=30