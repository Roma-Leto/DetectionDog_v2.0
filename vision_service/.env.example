# ============================================================
# DetectionDog Vision Service — переменные окружения
# Скопируйте в .env: cp .env.example .env
# ============================================================

# --- Сервер ---
HOST=0.0.0.0
PORT=5001
LOG_LEVEL=info

# --- Модель ---
# Варианты:
#   vikhyatk/moondream2      — стабильная версия, ~1.6B параметров
#   moondream/moondream-2b   — более новая (если доступна на HF)
MODEL_ID=vikhyatk/moondream2
MODEL_REVISION=2024-08-26

# --- Устройство ---
# auto  — автоматически (GPU если доступна, иначе CPU)
# cuda  — принудительно GPU
# cpu   — принудительно CPU
DEVICE=auto

# --- Тип данных ---
# float16 — быстрее на GPU, требует CUDA
# bfloat16 — быстрее на современных GPU (Ampere+), GTX 1080 не поддерживает
# float32 — совместимо со всем, но медленно
DTYPE=float16

# --- Ограничения ---
# Максимальный размер загружаемого фото (в байтах)
MAX_IMAGE_SIZE=16777216  # 16 МБ

# Таймаут на один inference (в секундах). На CPU может быть 30-60 сек.
INFERENCE_TIMEOUT=60

# --- Translator Service (ПК, порт 5002) ---
TRANSLATOR_SERVICE_URL=http://192.168.52.200:5002
TRANSLATOR_HEALTH_TIMEOUT=3
TRANSLATOR_TRANSLATE_TIMEOUT=30
TRANSLATOR_ENABLED=True