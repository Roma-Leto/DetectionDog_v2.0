# ============================================================
# DetectionDog v2.0 — шаблон переменных окружения
# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env
# ============================================================

# --- Flask ---
FLASK_APP=app:create_app
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DEBUG=True

# --- Database ---
# Формат: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Разработка на ПК → БД на нетбуке (192.168.52.105)
# Прод на нетбуке → БД на localhost
DATABASE_URL=postgresql+psycopg://ddog_app:CHANGE_ME@192.168.52.105:5432/detectiondog

# --- Uploads ---
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216
IMAGE_MAX_DIMENSION=1920
IMAGE_JPEG_QUALITY=85
THUMBNAIL_SIZE=300

# --- Vision Service (ПК в локальной сети) ---
VISION_SERVICE_URL=http://192.168.52.200:5001
VISION_HEALTH_TIMEOUT=3
VISION_ANALYZE_TIMEOUT=30

# --- Pagination ---
ITEMS_PER_PAGE=20

# --- Session ---
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400# ============================================================
